# ==============================================================================
# SPRINTLY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide appropriate values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Security
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-character-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Sprintly AI Service (Groq)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Email & 6-Digit OTP Verification (SMTP with App Passwords)
# For Gmail: Enable 2-Step Verification -> Go to https://myaccount.google.com/apppasswords -> Generate an App Password (16 letters)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Document Storage & Asynchronous Event Engine
MONGODB_URI=mongodb://localhost:27017
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Authentication & Session Security
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
